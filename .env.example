# Database Credentials
POSTGRES_USER=oona_admin
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=service_catalog
DB_DSN=postgres://oona_admin:your_secure_postgres_password_here@postgres:5432/service_catalog?sslmode=disable

# Service Configuration
PORT=8080
VALKEY_URL=valkey:6379

# Security & Secrets (JWT_SECRET min 32 chars, AES_ENCRYPTION_KEY exactly 32 chars)
JWT_SECRET=your_jwt_secret_key_at_least_32_chars_long
AES_ENCRYPTION_KEY=12345678901234567890123456789012

# Integrations (Optional)
GITHUB_TOKEN=
